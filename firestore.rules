rules_version = '2';
// قواعد أمان Firestore لنقطة البيع.
// أجهزة الكاشير تدخل بمصادقة مجهولة (لكل جهاز)، وهوية الكاشير الفعلية تُدار برمز PIN داخل التطبيق.
// لذلك نسمح بالقراءة والكتابة للمصادَقين فقط، وعلى مجموعة نقطة البيع (pos) وحدها.
//
// تنبيه: هذه قاعدة تشغيلية بسيطة. إن كانت بياناتك حسّاسة أو لديك عدة فروع منفصلة،
// شدّد القاعدة (مثلاً بربط الكتابة بقائمة أجهزة/مستخدمين معتمدين) قبل الإنتاج.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pos/{docId} {
      allow read, write: if request.auth != null;
    }
    // ارفض كل ما عداها افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
