# ============ منصة فاتورة (Fatora.io) — خادم فقط، لا يصل المتصفح أبداً ============
# احصل على مفتاح التاجر من لوحة تحكم فاتورة: https://fatora.io  ← الإعدادات ← مفاتيح API
FATORA_API_KEY=
# رابط API فاتورة (اتركه كما هو ما لم يُطلب خلاف ذلك)
FATORA_BASE_URL=https://api.fatora.io/v1
# الرابط العام لهذا التطبيق (يُستخدم لبناء روابط النجاح/الفشل التي تعيد إليها فاتورة العميل)
PUBLIC_BASE_URL=http://localhost:8787

PORT=8787

# ============ Firestore (اتركها فارغة لاستخدام خادم المشروع بدلاً منها) ============
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_COLLECTION=pos
